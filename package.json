{
  "name": "hostelhub-testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HostelHub QA — Playwright (web) + Appium (native) end-to-end automation with Page Object Model, smoke/regression suites and a Jira test-case catalogue",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:regression": "playwright test tests/regression",
    "test:mobile-web": "playwright test --project=chromium-mobile-web",
    "test:mobile": "wdio run wdio.conf.js",
    "test:ci": "playwright test tests/smoke tests/regression --project=chromium-desktop",
    "report": "playwright show-report reports/html",
    "testcases": "node scripts/generate-test-cases.js"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "webdriverio": "^9.0.0"
  }
}
