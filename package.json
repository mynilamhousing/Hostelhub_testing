{
  "name": "hostelhub-testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HostelHub QA — Playwright (web) + Appium (native) end-to-end automation with Page Object Model, smoke/regression suites and a Jira test-case catalogue",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "test": "npm run test:web:all",
    "test:web:smoke": "playwright test --config runners/playwright.config.js smoke.spec.js --project=desktop-chromium",
    "test:web:e2e": "playwright test --config runners/playwright.config.js e2e.spec.js --project=desktop-chromium",
    "test:web:regression": "playwright test --config runners/playwright.config.js regression.spec.js --project=desktop-chromium",
    "test:web:all": "playwright test --config runners/playwright.config.js --project=desktop-chromium",
    "test:web:mobile": "playwright test --config runners/playwright.config.js --project=mobile-web-chromium",
    "test:android:smoke": "wdio run runners/wdio.android.conf.js --suite smoke",
    "test:android:e2e": "wdio run runners/wdio.android.conf.js --suite e2e",
    "test:android:all": "wdio run runners/wdio.android.conf.js",
    "test:ios:smoke": "wdio run runners/wdio.ios.conf.js --suite smoke",
    "test:ios:e2e": "wdio run runners/wdio.ios.conf.js --suite e2e",
    "test:ios:all": "wdio run runners/wdio.ios.conf.js",
    "test:all": "npm run test:web:all && npm run test:android:all",
    "report": "playwright show-report reports/html",
    "testcases": "node scripts/generate-test-cases.js"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "webdriverio": "^9.0.0"
  }
}
